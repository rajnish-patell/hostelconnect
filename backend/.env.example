# Database Connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hostelconnect_db?schema=public"

# Master SuperAdmin Configuration
SUPERADMIN_EMAIL="patelrajnish47@gmail.com"
SUPERADMIN_DEFAULT_PASSWORD="YourSecurePasswordHere"

# Frontend & CORS Configuration
FRONTEND_URL="https://web-dashboard-pi-swart.vercel.app"
CORS_ORIGIN="https://web-dashboard-pi-swart.vercel.app,http://localhost:3000,http://localhost:5173"

# JWT Authentication Secrets
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=4000
NODE_ENV="development"
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# Email Provider Configuration (SMTP / Resend)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your-smtp-api-key"
SMTP_FROM="HostelConnect Security <security@hostelconnect.io>"
RESEND_API_KEY=""

# LiveKit WebRTC Video Calling Infrastructure
LIVEKIT_URL="wss://livekit.hostelconnect.internal"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secretkeysecretkeysecretkeysecretkey"
