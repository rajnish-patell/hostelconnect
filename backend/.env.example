# ==============================================
# Hostel Video Call Platform — Environment Config
# ==============================================

# Server
PORT=5000
NODE_ENV=development    # development | production
DEMO_MODE=true          # true = allows demo passwords/OTP for dev. Set false in production.

# Database
# SQLite (development):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@localhost:5432/hostel_video_call?schema=public"

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway
# Sign up at https://dashboard.razorpay.com
# Use "Test" keys for sandbox, "Live" keys for production.
# NEVER commit live keys to source control.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_from_razorpay_dashboard

# CORS — Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# Agora Video Calling (replace with your credentials from https://console.agora.io)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Platform defaults
DEFAULT_PER_MINUTE_CHARGE=2.50
DEFAULT_CALL_DURATION_MINS=10

# SMTP Email Configuration (Nodemailer for real Email OTP delivery)
# Works with Gmail, Resend, SendGrid, Mailgun, Amazon SES, or custom SMTP servers
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Hostel Video Call" <your_email@gmail.com>

# Resend Email Delivery (Production Email OTP)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="Hostel Connect" <onboarding@resend.dev>

# Mobile SMS OTP Configuration (Twilio or Fast2SMS API)
SMS_PROVIDER=none          # twilio | fast2sms | none
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
FAST2SMS_API_KEY=your_fast2sms_api_key


